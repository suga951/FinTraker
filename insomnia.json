      "headers": [
        { "name": "Authorization", "value": "Bearer {{token}}" }
      ]
    },
    {
      "_id": "req_categories_create",
      "_type": "request",
      "name": "Create Category",
      "url": "{{base_url}}/categories/",
      "method": "POST",
      "body": {
        "mode": "json",
        "json": "{\n  \"name\": \"Groceries\",\n  \"type\": \"EXPENSE\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{token}}" }
