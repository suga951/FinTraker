{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-04-02T00:00:00.000Z",
  "__export_source": "fintraq-api",
  "resources": [
    {
      "_id": "env_fintrak",
      "_type": "environment",
      "name": "FinTrakr",
      "data": {
        "base_url": "http://localhost:8000",
        "token": ""
      }
    },
    {
      "_id": "req_register",
      "_type": "request",
      "name": "Register",
      "url": "{{base_url}}/auth/register",
      "method": "POST",
      "body": {
        "mode": "json",
        "json": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test1234!\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_login",
      "_type": "request",
      "name": "Login",
      "url": "{{base_url}}/auth/login",
      "method": "POST",
      "body": {
        "mode": "form",
        "form": [
          { "name": "username", "value": "test@example.com" },
          { "name": "password", "value": "Test1234!" }
        ]
      },
      "headers": [
        { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
      ]
    },
    {
      "_id": "req_dashboard",
      "_type": "request",
      "name": "Get Dashboard Stats",
      "url": "{{base_url}}/dashboard/",
      "method": "GET",
      "parameters": [
        { "name": "all_time", "value": "false" },
        { "name": "start_date", "value": "" },
        { "name": "end_date", "value": "" }
      ],
      "headers": [
        { "name": "Authorization", "value": "Bearer {{token}}" }
      ]
    },
    {
      "_id": "req_categories_list",
      "_type": "request",
