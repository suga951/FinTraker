      "url": "{{base_url}}/transactions/",
      "method": "POST",
      "body": {
        "mode": "json",
        "json": "{\n  \"description\": \"Weekly groceries\",\n  \"amount\": 150.00,\n  \"type\": \"EXPENSE\",\n  \"category_id\": 1\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{token}}" }
      ]
    },
    {
      "_id": "req_transactions_get",
      "_type": "request",
      "name": "Get Transaction",
      "url": "{{base_url}}/transactions/1",
