        "mode": "json",
        "json": "{\n  \"description\": \"Updated description\",\n  \"amount\": 200.00\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{token}}" }
      ]
    },
    {
      "_id": "req_transactions_delete",
      "_type": "request",
      "name": "Delete Transaction",
      "url": "{{base_url}}/transactions/1",
      "method": "DELETE",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{token}}" }
      ]
    },
    {
      "_id": "folder_auth",
      "_type": "request_group",
      "name": "Auth",
      "requests": ["req_register", "req_login"]
    },
    {
      "_id": "folder_dashboard",
      "_type": "request_group",
      "name": "Dashboard",
      "requests": ["req_dashboard"]
    },
    {
      "_id": "folder_categories",
      "_type": "request_group",
      "name": "Categories",
      "requests": [
        "req_categories_list",
        "req_categories_create",
        "req_categories_get",
        "req_categories_update",
        "req_categories_delete"
      ]
    },
    {
      "_id": "folder_transactions",
      "_type": "request_group",
      "name": "Transactions",
      "requests": [
        "req_transactions_list",
        "req_transactions_create",
        "req_transactions_get",
        "req_transactions_update",
        "req_transactions_delete"
      ]
    }
